{
  "name": "hidden-music-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev": "npm run dev:web",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build": "npm run build:web && npm run build:api",
    "deploy:web": "npm run deploy --workspace=apps/web",
    "deploy:api": "npm run deploy --workspace=apps/api",
    "ship": "node scripts/auto-ship.mjs",
    "auto-push": "git add . && git commit -m \"chore: update & auto-sync\" && git push origin main"
  },
  "dependencies": {
    "web-audio-beat-detector": "^8.2.39"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
